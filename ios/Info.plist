<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>EasyTrans</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>de</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>EasyTrans hört dem Gespräch zu, um es live zu übersetzen.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>EasyTrans wandelt Sprache auf dem Gerät in Text um, um sie zu übersetzen.</string>
